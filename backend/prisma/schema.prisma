generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

enum LeadStatus {
  NEW
  NO_CONTACT
  CONTACTED
  INTERESTED
  LINK_B2B_SENT
  NEGOTIATION
  CONVERTED
  NOT_INTERESTED
  INACTIVE
}

enum PotentialLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImportStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
}

enum ContactSource {
  IMPORT
  PUBLIC
  MANUAL
}

// ── Tabela Legada de Usuários (Mantida intacta durante transição) ─────────────
model User {
  id                      String            @id @default(cuid())
  name                    String
  email                   String            @unique
  passwordHash            String
  role                    UserRole          @default(SALES)
  status                  UserStatus        @default(ACTIVE)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  assignedLeadsLegacy     Lead[]            @relation("LeadAssigneeLegacy")
  interactionsLegacy      LeadInteraction[] @relation("InteractionUserLegacy")
  invitationsReceived     UserInvitation[]  @relation("InvitationRecipient")
  invitationsCreated      UserInvitation[]  @relation("InvitationCreator")

  @@map("users")
}

model UserInvitation {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  user      User  @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_invitations")
}

// ── Mapeamento Persistente CUID -> UUID (Idempotente) ────────────────────────
model UserMapping {
  cuid       String   @id
  uuid       String   @unique @db.Uuid
  email      String
  migratedAt DateTime @default(now())

  @@map("user_mappings")
}

// ── Perfis do Supabase Auth (Vinculado a auth.users via UUID) ─────────────────
model Profile {
  id            String            @id @db.Uuid
  name          String
  email         String            @unique
  role          UserRole          @default(SALES)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assignedLeads Lead[]            @relation("LeadAssigneeProfile")
  interactions  LeadInteraction[] @relation("InteractionUserProfile")

  @@map("profiles")
}

model City {
  id        String   @id @default(cuid())
  name      String
  uf        String
  ibgeCode  String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, uf])
  @@map("cities")
}

model Cnae {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  category    String?
  isTarget    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cnaes")
}

model Company {
  id                        String          @id @default(cuid())
  cnpj                      String?         @unique
  externalId                String?
  placeId                   String?
  source                    String          @default("receita_federal")
  
  razaoSocial               String
  nomeFantasia              String?
  situacaoCadastral         String
  porte                     String?
  matrizFilial              String?
  dataAbertura              DateTime?
  cnaePrincipal             String?
  uf                        String
  cidade                    String
  bairro                    String?
  cep                       String?
  logradouro                String?
  numero                    String?
  complemento               String?
  latitude                  Float?
  longitude                 Float?
  lastSyncAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  // ─── Rastreabilidade de Coordenadas ───────────────────────────────────────
  origemCoordenada          String?
  statusVerificacaoEndereco String?
  confiancaVerificacao      Int?

  // ─── Qualidade Cadastral ──────────────────────────────────────────────────
  enderecoCompleto          Boolean         @default(false)
  pendenteValidacao         Boolean         @default(false)
  motivosPendencia          Json?

  // ─── Pontuação Comercial ──────────────────────────────────────────────────
  pontuacaoOportunidade     Int             @default(0)
  nivelOportunidade         String?
  motivoPontuacao           Json?

  // ─── Geocodificação Futura ────────────────────────────────────────────────
  latitudeVerificada        Float?
  longitudeVerificada       Float?
  enderecoVerificado        String?
  fonteGeocodificacao       String?
  dataVerificacaoGeo        DateTime?

  // ─── Validação Manual de Localização & Evidências ─────────────────────────
  validadoManualmente       Boolean         @default(false)
  dataUltimaValidacao       DateTime?
  usuarioValidacaoId        String?
  observacaoValidacao       String?
  statusValidacao           String?         @default("aguardando_validacao")

  fonteConsultada           String?
  urlEvidencia              String?
  nomeEncontrado            String?
  enderecoEncontrado        String?
  telefoneEncontrado        String?
  categoriaEncontrada       String?
  situacaoAparente          String?
  distanciaAproximadaMeters Float?
  justificativaDecisao      String?
  nomeResponsavelVisita     String?
  dataVisita                DateTime?
  evidenciaVisita           String?

  cnaes                     CompanyCnae[]
  lead                      Lead?
  details                   CompanyDetails?
  contacts                  CompanyContact[]
  clientAccounts            ClientAccount[]
  locationAudits            CompanyLocationAudit[]

  @@unique([source, externalId])
  @@index([cidade, uf])
  @@index([cnaePrincipal])
  @@index([situacaoCadastral])
  @@index([source])
  @@index([placeId])
  @@map("companies")
}

model CompanyCnae {
  id        String  @id @default(cuid())
  companyId String
  cnaeCode  String
  isPrimary Boolean @default(false)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cnaeCode])
  @@index([cnaeCode])
  @@map("company_cnaes")
}

// ── Base Comercial Privada da Deusa (Clientes Excel & Cruzamento) ──────────────
model ClientAccount {
  id                 String   @id @default(uuid())
  codigoClienteDeusa String?  @unique
  cnpj               String?
  razaoSocial        String
  nomeFantasia       String?
  isCurrentClient    Boolean  @default(true)
  grupoEconomico     String?
  segmentoAtuacao    String?
  cidade             String?
  uf                 String?
  
  companyId          String?
  importedFromExcel  Boolean  @default(true)
  lastImportAt       DateTime @default(now())
  metadata           Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company            Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([cnpj])
  @@index([companyId])
  @@index([isCurrentClient])
  @@map("client_accounts")
}

model Lead {
  id                  String            @id @default(cuid())
  companyId           String            @unique
  status              LeadStatus        @default(NEW)
  score               Int               @default(0)
  potentialLevel      PotentialLevel    @default(LOW)
  pendenteValidacao   Boolean           @default(false)
  
  // Coluna UUID apontando para Profiles
  assignedToId        String?           @db.Uuid
  // Coluna Legada mantida durante transição
  assignedToId_legacy String?
  
  notes               String?
  lastContactAt       DateTime?
  nextActionAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo          Profile?          @relation("LeadAssigneeProfile", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToLegacy    User?             @relation("LeadAssigneeLegacy", fields: [assignedToId_legacy], references: [id], onDelete: SetNull)
  interactions        LeadInteraction[]

  @@index([status])
  @@index([potentialLevel])
  @@index([score])
  @@map("leads")
}

model LeadInteraction {
  id             String   @id @default(cuid())
  leadId         String
  
  // Coluna UUID apontando para Profiles
  userId         String?  @db.Uuid
  // Coluna Legada mantida durante transição
  userId_legacy  String?

  type           String
  description    String
  createdAt      DateTime @default(now())

  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           Profile? @relation("InteractionUserProfile", fields: [userId], references: [id], onDelete: Cascade)
  userLegacy     User?    @relation("InteractionUserLegacy", fields: [userId_legacy], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@map("lead_interactions")
}

model ImportJob {
  id           String       @id @default(cuid())
  uf           String
  cityName     String
  cityIbgeCode String?
  cnaeCode     String
  status       ImportStatus @default(PENDING)
  totalFound   Int          @default(0)
  totalSaved   Int          @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([cityName, uf])
  @@map("import_jobs")
}

model CompanyDetails {
  id               String   @id @default(cuid())
  companyId        String   @unique
  naturezaJuridica String?
  telefone         String?
  email            String?
  descricaoCnae    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_details")
}

model CompanyContact {
  id              String        @id @default(cuid())
  companyId       String
  type            ContactType
  value           String
  source          ContactSource @default(MANUAL)
  createdBy       String?       @db.Uuid
  createdByLegacy String?
  isPrimary       Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, value])
  @@index([companyId])
  @@index([type])
  @@index([source])
  @@index([active])
  @@map("company_contacts")
}

model CompanyLocationAudit {
  id                  String   @id @default(cuid())
  companyId           String
  responsibleUserId   String
  previousLatitude    Float?
  previousLongitude   Float?
  newLatitude         Float
  newLongitude        Float
  origin              String   @default("MANUAL_MAP_ADJUSTMENT")
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([responsibleUserId])
  @@map("company_location_audits")
}
