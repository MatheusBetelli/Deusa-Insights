# ── Deusa Analytics Backend — Environment Variables ────────────────────────────
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no git.

# ── PostgreSQL / Supabase ──────────────────────────────────────────────────────
# DATABASE_URL: Usada pela aplicação em runtime (em Supabase com pooler/Supavisor na porta 6543)
DATABASE_URL=""
# DIRECT_URL: Usada pelo Prisma para migrations e comandos DDL (em Supabase porta direta 5432)
# O schema Prisma exige esta variável também no generate/validate; em ambiente local use a mesma URL direta.
DIRECT_URL=""

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=""
NODE_ENV=""

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBRIGATÓRIO: mínimo de 32 caracteres em produção.
JWT_SECRET=""

# ── CORS — URLs permitidas do Frontend ────────────────────────────────────────
# Em produção, configure ALLOWED_ORIGINS com os domínios reais separados por vírgula.
FRONTEND_URL=""
ALLOWED_ORIGINS=""

# Congelamento da carteira. Use true apenas durante uma alteração explicitamente autorizada.
ENABLE_LEAD_MUTATIONS=false

# ── APIs Externas ──────────────────────────────────────────────────────────────
CNPJ_API_BASE_URL=""
CNPJ_API_TOKEN=""

# Google Maps (Geocoding & Places) — obtenha em https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=""

# Resend (E-mail de redefinição de senha) — obtenha em https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ── Seed (opcionais em dev, OBRIGATÓRIAS em produção) ──────────────────────────
# SEED_ADMIN_PASSWORD="senha-forte-admin"
# SEED_SALES_PASSWORD="senha-forte-vendas"
