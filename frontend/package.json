{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "check:artifact": "node ../scripts/check-frontend-artifact.cjs",
    "deploy": "npm run build && npm run check:artifact && wrangler deploy",
    "deploy:dry-run": "npm run build && npm run check:artifact && wrangler deploy --dry-run --outdir dist/worker-dry-run",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip --no-config-hints",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "data:import": "node --experimental-sqlite scripts/data/import-data.js",
    "data:compare": "node --experimental-sqlite scripts/data/compare-data.js",
    "data:prepare": "node --experimental-sqlite scripts/data/prepare-data.js",
    "test": "tsx ../scripts/run-frontend-tests.mjs",
    "test:e2e": "tsx --test src/e2e.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@eslint/js": "10.0.1",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "knip": "^6.32.2",
    "prettier": "^3.7.3",
    "read-excel-file": "^9.3.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.1",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^7.29.0"
  }
}
