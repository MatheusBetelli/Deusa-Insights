# ─────────────────────────────────────────────────────────────────────────────
# Deusa Analytics — Template de Variáveis de Produção
# Copie este arquivo para .env.production e preencha TODOS os campos.
# NUNCA commite o arquivo .env.production no git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usadas pelo docker-compose.prod.yml para criar o banco e pelo backend (via DATABASE_URL)
POSTGRES_USER=deusa_prod
POSTGRES_PASSWORD=ALTERE_PARA_SENHA_FORTE_AQUI
POSTGRES_DB=deusa_analytics_prod

# ── Backend NestJS ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# JWT_SECRET: gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBRIGATÓRIO: mínimo de 32 caracteres. Chave curta ou padrão causará process.exit(1) na inicialização.
JWT_SECRET=GERE_UM_SEGREDO_FORTE_E_ALEATORIO_AQUI

# URL do banco de dados (Supabase PostgreSQL ou PostgreSQL local):
# Para Supabase (gerenciado gratuito):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Para PostgreSQL local / Docker:
# DATABASE_URL=postgresql://deusa_prod:SENHA@localhost:5432/deusa_analytics_prod?schema=public

# URL do Frontend em produção — usada para CORS
FRONTEND_URL=https://seu-dominio-frontend.com
ALLOWED_ORIGINS=https://seu-dominio-frontend.com

# Congelamento da carteira comercial. Produção bloqueia mutações quando ausente ou false.
ENABLE_LEAD_MUTATIONS=false

# Recuperação de senha (obrigatória em produção)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Frontend (Cloudflare Workers) ─────────────────────────────────────────────
# Defina no dashboard da Cloudflare como variável de ambiente / secret.
# Não é lida pelo docker-compose.prod.yml — referência apenas.
# VITE_API_URL=https://api.seu-dominio.com
